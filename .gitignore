# --- project ---
prompt.txt

# --- secrets / local config ---
.env
.env.*
!.env.example
deploy/tls/*.pem
deploy/tls/*.key
deploy/tls/*.crt
*.key
**/secrets/*
!**/secrets/.gitkeep

# --- guideline corpus (operator-supplied; large + licensed — never commit) ---
data/excerpt_guidelines/*
!data/excerpt_guidelines/.gitkeep
!data/excerpt_guidelines/manifest.example.json
# real manifest.json is operator-specific (may carry unpublished refs) — keep it local
data/excerpt_guidelines/manifest.json
# --- full-publication archival copies for partial-page-extract provenance (DEVIATIONS #167) ---
# never scanned or read by any ingestion code path — see data/guideline_sources/README.md
data/guideline_sources/*
!data/guideline_sources/.gitkeep
!data/guideline_sources/README.md
data/eval_snapshots/*
!data/eval_snapshots/.gitkeep
data/eav_cache/*
# Ingestion crops (ARCH-044): derived from the source PDFs, regenerated on ingest.
data/ingest_artifacts/*
!data/ingest_artifacts/.gitkeep
!data/eav_cache/.gitkeep

# --- patient record datasets (synthetic OR de-identified) — NEVER commit any
#     dataset file, even de-identified. Only small text sidecars are tracked. ---
data/patient_records/**
!data/patient_records/**/
!data/patient_records/**/.gitkeep
!data/patient_records/**/DATASET.md
!data/patient_records/**/field_mapping.yaml

# --- python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.sqlite3

# --- node / frontend ---
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# --- editors / os ---
.idea/
.vscode/
.DS_Store
*.swp

# --- docker / runtime volumes (if bind-mounted locally) ---
.docker-data/

# generated CI-only synthetic guideline fixtures (DEVIATIONS #26)
backend/tests/fixtures/guidelines/*
!backend/tests/fixtures/guidelines/.gitkeep

# --- unified-ablation run output (PRD-112/ARCH-043) — per-query JSONL can run
#     into the hundreds of MB per run (real run, DEVIATIONS #197: 472MB/180,880
#     rows for one 238-question run); never commit a run's raw output, only
#     its own README explaining the layout ---
backend/results/ablation/*
!backend/results/ablation/.gitkeep
!backend/results/ablation/README.md
