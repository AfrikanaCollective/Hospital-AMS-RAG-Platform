# Hospital RAG Platform — configuration template.
# Copy to .env and edit. .env is gitignored. Never put secrets in .env.example.
# Full reference: ARCHITECTURE.md §20.

# ─── App ───────────────────────────────────────────────────────────────────────
APP_ENV=dev                       # dev | staging | prod
LOG_LEVEL=INFO
API_BASE_PATH=/api
REQUEST_ID_HEADER=x-request-id

# ─── LLM gateway (ARCH-005 / PRD-101 / PRD-102) ───────────────────────────────
# http:// is only accepted here for the docker-compose-internal dev stub. The
# real gateway is external (ARCHITECTURE.md §19) and this call path carries
# PHI-adjacent content for SCOPE-2 flows — use https:// for anything else, or
# app.config.Settings.validate_gateway_transport logs a warning at startup
# (PRD-082, ARCH §17.2, DEVIATIONS.md #54).
LLM_GATEWAY_URL=http://llm-gateway:8080
# Bearer token, if the gateway requires one; set only in your local .env,
# never committed. Left with no value below on purpose — see the note above
# MODEL_ID_FALLBACKS a few lines down about why an inline comment on an
# otherwise-empty line is unsafe here, not just untidy.
LLM_GATEWAY_API_KEY=
# Both optional, empty by default (normal case: a properly-named cert on a
# recognized CA). Set LLM_GATEWAY_CA_BUNDLE (a PEM path) to additionally
# trust a self-signed/internal-CA gateway cert without ever disabling
# verification. Set LLM_GATEWAY_SNI_HOSTNAME only if LLM_GATEWAY_URL's own
# hostname genuinely isn't what the cert covers — e.g. reaching a gateway via
# host.docker.internal whose cert was issued for "localhost" — this
# overrides just the TLS SNI/hostname-verification target, not which host is
# connected to (DEVIATIONS.md #103).
LLM_GATEWAY_CA_BUNDLE=
LLM_GATEWAY_SNI_HOSTNAME=
MODEL_ID=<set-me>                  # REQUIRED. Answer path refuses to start on this placeholder.
# Comma-separated fallback model ids (fallback routing). Left with NO
# trailing inline comment when empty, deliberately (DEVIATIONS.md #115):
# python-dotenv does not strip a `# comment` on a line whose value is empty
# (`KEY=   # comment` parses to the literal string "# comment", not ""),
# unlike a line that has a real value before the comment — a real,
# previously-live bug here sent that literal comment text to the gateway as
# a bogus fallback "model id". Never give an empty-valued var an inline
# comment on the same line in this file; put the comment above it instead.
MODEL_ID_FALLBACKS=
MODEL_ID_VERIFIED=false           # set true ONLY after checking the id against current gateway docs
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2

# ─── Embeddings / reranker (ARCH-004 / ARCH-012 / PRD-103) ────────────────────
# Placeholder defaults below are UNVERIFIED — confirm or override before relying on them.
EMBEDDING_BACKEND=stub            # local | gateway | stub
# EMBEDDING_MODEL_ID format depends on EMBEDDING_BACKEND:
#   local   -> a HuggingFace repo id, e.g. BAAI/bge-large-en-v1.5
#   gateway -> the gateway's own model tag, e.g. qllama/bge-large-en-v1.5:latest
#              (operator-confirmed against a real self-hosted gateway; DEVIATIONS.md #42)
EMBEDDING_MODEL_ID=BAAI/bge-large-en-v1.5
EMBEDDING_MODEL_VERIFIED=false
EMBEDDING_QUERY_PREFIX=
EMBEDDING_DOC_PREFIX=
# Used when EMBEDDING_BACKEND=gateway (DEVIATIONS.md #42/#103). May be a
# different host/service than LLM_GATEWAY_URL above — this is a BASE URL,
# app/ingestion/embed.py appends /v1/embeddings itself; do not include the
# path here. Never put the real API key in this file — set it in your local
# .env only.
EMBEDDING_GATEWAY_URL=
EMBEDDING_GATEWAY_API_KEY=
# Same self-signed-cert / SNI-override support as LLM_GATEWAY_CA_BUNDLE /
# LLM_GATEWAY_SNI_HOSTNAME above (DEVIATIONS.md #103), for this gateway.
EMBEDDING_GATEWAY_CA_BUNDLE=
EMBEDDING_GATEWAY_SNI_HOSTNAME=
RERANKER_BACKEND=local             # decided (DEVIATIONS.md #44) — gateway is not a supported option here
RERANKER_MODEL_ID=BAAI/bge-reranker-v2-m3
RERANKER_MODEL_VERIFIED=false
# Local in-process serving knobs (DEVIATIONS.md #43/#44).
# Design: sentence-transformers CrossEncoder — install the `local-models`
# extra (pip install -e ".[dev,local-models]") to get it + torch. NOTE: the
# committed backend/Dockerfile does NOT install this extra by default (kept
# light for the stub-only image); building api/worker images that actually
# run RERANKER_BACKEND=local needs `.[dev,local-models]` added there first —
# not yet done (Phase 2 work). Tests always force RERANKER_BACKEND=stub via
# tests/conftest.py regardless of this file, so `make test`/CI is unaffected.
RERANKER_DEVICE=auto              # auto | cpu | cuda
RERANKER_BATCH_SIZE=16
RERANKER_MAX_LENGTH=512
# Where HF model weights are cached inside the container — point this at a
# persistent volume (see docker-compose.yml `hf-model-cache`) so the ~1.1GB
# reranker weights aren't re-downloaded from the internet on every restart.
HF_HOME=/home/appuser/.cache/huggingface

# ─── Model-ablation harness only (PRD-110 / ARCH-041) ───────────────────────
# SapBERT/MedCPT vs. BM25, evaluated offline against the live guideline
# corpus — see PHASE2-EMBEDDING-ABLATION-PROPOSAL.md. NOT read by any
# production/answer-path code. Repo ids and pooling method are UNVERIFIED
# against each model's current card — confirm before trusting a real
# (non-stub) run's numbers, then set the matching *_VERIFIED=true.
MODEL_ABLATION_BACKEND=stub       # stub | local
SAPBERT_MODEL_ID=cambridgeltl/SapBERT-from-PubMedBERT-fulltext
SAPBERT_MODEL_VERIFIED=false
MEDCPT_QUERY_MODEL_ID=ncbi/MedCPT-Query-Encoder
MEDCPT_ARTICLE_MODEL_ID=ncbi/MedCPT-Article-Encoder
MEDCPT_MODEL_VERIFIED=false

# ─── Retrieval (ARCH-003 / §7) ───────────────────────────────────────────────
CANDIDATE_K=40
FUSED_K=24
TOP_K=8
RRF_K=60
RETRIEVAL_MIN_SCORE=0.30          # tune on the eval set
SUPPORT_SCORE_FLOOR=0.20
MIN_SUPPORTING_CHUNKS=2
GROUNDING_ENTAILMENT_MODE=hybrid  # lexical | model | hybrid

# ─── Vector store (ARCH-002) ─────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=change-me-in-real-deploy
QDRANT_GUIDELINE_COLLECTION=guideline_chunks_v1
PATIENT_RECORD_VECTORS_ENABLED=false          # keep off (ARCH-023 / DEVIATIONS #8)

# ─── Guideline corpus + ingestion (ARCH-038 / DEVIATIONS #26, #28, #30) ──────
SAMPLE_GUIDELINES_DIR=data/excerpt_guidelines
GUIDELINES_ALLOW_SYNTHETIC=false               # true = allow the CI-only synthetic fixture set
INGEST_MIN_PARSE_QUALITY=0.60                   # below -> every chunk held for admin review (ARCH-044)

# ─── Layout-aware PDF ingestion (ARCH-044 / PRD-113 / LAYOUT-INGESTION-PROPOSAL.md) ─
# layout = Docling + pdfplumber + local OCR (image installs requirements-layout.txt;
# run `python -m scripts.fetch_layout_models` once to cache model weights).
# pypdf  = original text-only path (also the automatic fallback on parser failure).
INGEST_PARSER=layout
INGEST_OCR_ENGINE=rapidocr                      # rapidocr | easyocr | tesseract (bake-off: DEVIATIONS #215)
INGEST_OCR_FORCE_PAGE_BELOW_CHARS=200           # pages with fewer text-layer chars are reported as OCR-dependent
INGEST_IMAGES_SCALE=2.0                         # figure/table crop render scale
INGEST_MARGIN_ZONE=0.08                         # header/footer zone, fraction of page height
INGEST_BOILERPLATE_REPEAT_RATIO=0.5             # margin text on >= this share of pages is boilerplate…
INGEST_BOILERPLATE_MIN_PAGES=3                  # …but only for documents with at least this many pages
INGEST_TABLE_MAX_TOKENS=700                     # larger tables split by row group, header repeated
INGEST_CROP_DIR=data/ingest_artifacts/crops     # content-addressed crops for the corpus review UI

# ─── Vision-LLM table transcription (ARCH-044 D12 / proposal §18 / DEVIATIONS #219) ─
# ocr_only = re-transcribe OCR tables via the gateway's image endpoint; every
# transcribed table is held for admin review. off = OCR only.
INGEST_VLM_TABLES=off
VISION_ENDPOINT_PATH=/generate-with-image
VISION_MODEL_ID=<set-me>                        # the model the gateway is EXPECTED to answer with
VISION_MODEL_ID_VERIFIED=false
INGEST_VLM_CROP_SCALE=3.0
INGEST_VLM_MAX_IMAGE_MB=8
INGEST_VLM_TIMEOUT_S=300
INGEST_VLM_MAX_RETRIES=2
INGEST_VLM_CACHE_DIR=data/ingest_artifacts/vlm_cache
# OCR prose (text/list items/captions/footnotes) -> vision model by default once
# VISION_MODEL_ID is set (DEVIATIONS #222). off | ocr_only
INGEST_VLM_PROSE=ocr_only

# ─── Patient records (ARCH-039 / DEVIATIONS #30, #33, #34) ───────────────────
PATIENT_RECORDS_DIR=data/patient_records        # synthetic/ + deidentified/<dataset>/ live here
RECORD_DOMAIN=neonatal                          # neonatal | adult_inpatient — synthetic generator + corpus domain
DEIDENTIFIED_ATTESTATION_REQUIRED=true          # de-identified datasets need a complete DATASET.md attestation

# ─── Database (ARCH-008) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://hrag_app:hrag_app_pw@postgres:5432/hospital_rag
# app role has NO UPDATE/DELETE on the audit schema — see deploy/postgres/init/01_schemas_roles.sql
# Alembic-only, elevated (DDL) credential — hrag_app above has no CREATE
# privilege on the managed schemas, by design (DEVIATIONS.md #61). Never used
# by the running app, only by `alembic upgrade`/`alembic revision`.
ALEMBIC_DATABASE_URL=postgresql+psycopg://hrag_admin:hrag_admin_pw@postgres:5432/hospital_rag

# ─── Async (ARCH-007) ───────────────────────────────────────────────────────
REDIS_URL=redis://:redis_pw@redis:6379/0
CELERY_BROKER_URL=redis://:redis_pw@redis:6379/1
CELERY_RESULT_BACKEND=redis://:redis_pw@redis:6379/2

# ─── Auth / RBAC (ARCH-011 / ARCH-034) ──────────────────────────────────────
AUTH_PROVIDER=devjwt              # devjwt | oidc
DEVJWT_SIGNING_KEY=dev-only-change-me-32-bytes-minimum!!
DEVJWT_ISSUER=hospital-rag-dev
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

# ─── Crypto / secrets (ARCH-032 / ARCH-033) ─────────────────────────────────
SECRETS_BACKEND=file             # env | file | vault
CRYPTO_KEK_FILE=./secrets/dev_kek.bin   # DEV KEY — not for real data
VAULT_ADDR=
VAULT_TOKEN=

# ─── HITL / rubric (ARCH-018 / ARCH-020 / ARCH-021) ─────────────────────────
ESCALATION_SLA_MINUTES=60
IRR_MIN_RATERS=3
IRR_METRIC=krippendorff_alpha_ordinal
REVIEW_WEBHOOK_URL=

# ─── Auto question generation (ARCH-022 / PRD-065) ──────────────────────────
QGEN_COMPOSITION=60,20,20         # well_supported,missing_info_expected,no_guideline_expected
# Jaccard threshold (0-1) over each candidate record's own (examination
# findings ∪ problems) set for the diversity/near-duplicate filter — a
# candidate is rejected only when this AND every shared vitals field is
# within its tolerance band (app.eval.question_gen.diversity). NOT the same
# scale as the pre-DEVIATIONS-#188 value: this was a whole-narrative-text
# cosine-similarity threshold through two prior attempts (0.92 original
# placeholder; raised to 0.96 in DEVIATIONS #119 after the SAME saturation
# symptom — the narrative template is repetitive enough that whole-sentence
# embedding similarity saturated once the accepted pool reached ~55
# questions, rejecting ~90%+ of new candidates even though no two accepted
# questions were ever that similar). #188 found that raising the threshold
# again didn't hold at a larger pool size either (0/41 successes with the
# old mechanism even at 0.96) and replaced the whole approach with a
# structured-field comparison — this value (0.8) is calibrated for the new
# Jaccard scale, not comparable to 0.92/0.96 if you have this set from before.
QGEN_DEDUP_THRESHOLD=0.8
QGEN_MAX_RETRIES=3

# ─── Auto-seed the rubric review queue (ARCH §14.2/§15; DEVIATIONS #113, #114) ──
# On every API startup, generates unique guideline-lookup hypotheticals from
# already-ingested de-identified records (see `scripts/ingest_deidentified_records.py`
# --attest-deidentified --persist), runs each through the real query
# pipeline, and queues the result for rubric review — idempotent, tops up to
# QGEN_AUTO_SEED_COUNT rather than duplicating on restart. Each scenario is
# backed by exactly one de-identified record, never reused across runs, and
# the near-duplicate check compares against every previously-queued
# narrative, not just this run's. Skips (logs a warning) if no de-identified
# records have been ingested yet, or MODEL_ID is still the placeholder.
QGEN_AUTO_SEED_ENABLED=true
QGEN_AUTO_SEED_COUNT=100
# Optional: restrict to one ingested dataset_id, e.g. newborn_nbu_2021. No
# inline comment on the line below when empty — see DEVIATIONS.md #115.
QGEN_AUTO_SEED_DATASET_ID=

# ─── Unified-ablation record hold-out (PRD-112/ARCH-043; DEVIATIONS #199) ──
# Target count for `app.eval.auto_seed.run_ablation_holdout_generation`
# (`python -m scripts.generate_ablation_holdout_questions`) — a SEPARATE,
# review-queue-FREE sibling of QGEN_AUTO_SEED_COUNT's own pipeline above.
# Writes ONLY eval_question rows (never a Result/review-queue item) for the
# unified ablation study's calibration pool. Top-up semantics, same as
# QGEN_AUTO_SEED_COUNT. A de-identified record consumed here is durably
# excluded from the review queue (and vice versa) — never reused across
# either pipeline. Not free: one real LLM-gateway call per attempt,
# real yield ~50% (most newborn presentations legitimately fall outside
# the ingested corpus's narrow antibiotic/infection scope and escalate).
ABLATION_HOLDOUT_TARGET_COUNT=2500

# ─── Eval harness gating (§16) ─────────────────────────────────────────────
EVAL_MIN_PRECISION_AT_8=0.70
EVAL_MIN_RECALL_AT_24=0.80
EVAL_MIN_CITATION_SUPPORT_RATE=0.95
EVAL_REQUIRE_ZERO_SCOPE_VIOLATIONS=true
EVAL_REQUIRE_FULL_DISCLAIMER=true

# ─── Retention (PRD-Q3) ────────────────────────────────────────────────────
RETENTION_AUDIT_DAYS=3650
RETENTION_CONTEXT_DAYS=1825
RETENTION_CONV_DAYS=730
CHECKPOINT_TTL_DAYS=30

# ─── Extension seam (ARCH-026 / CDS-FUTURE.md) ─────────────────────────────
LOCAL_ADAPTATION_ENABLED=false    # inert — flipping this does nothing without governance-gated implementation
